{
  "info": {
    "name": "Messaging System - Status Tracking",
    "description": "Postman collection for the ASP.NET Core messaging API with explicit client acknowledgements.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "senderId",
      "value": ""
    },
    {
      "key": "receiverId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Sender User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('sender created', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('senderId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      }
    },
    {
      "name": "Create Receiver User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('receiver created', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('receiverId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"bob\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      }
    },
    {
      "name": "Send Message",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('message sent', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('messageId', pm.response.json().messageId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": {{senderId}},\n  \"receiverId\": {{receiverId}},\n  \"content\": \"Hello Bob\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "messages"
          ]
        }
      }
    },
    {
      "name": "Acknowledge Delivered",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Delivered\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/messages/{{messageId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "messages",
            "{{messageId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "Acknowledge Read",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Read\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/messages/{{messageId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "messages",
            "{{messageId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "Get Sender Conversation History",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{senderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{senderId}}"
          ]
        }
      }
    }
  ]
}
